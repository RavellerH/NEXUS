# ==============================================================================
# NEXUS Environment Variables - Option A Dev & Production Blueprint
# ==============================================================================

# Security Options
# Secure 32-byte JWT signature key. Auto-generated if left empty on system setup.
JWT_SECRET=

# Core Host/API Scaffolding
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
PORT=8000

# Vector Database (ChromaDB)
# Local host persistent sqlite folder. Maps to /app/data/chromadb inside Docker.
CHROMADB_PATH=./data/chromadb

# Local Model Configurations (Ollama Production Target)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_MODEL=qwen2.5:7b

# ==============================================================================
# Cloud API Development Fallback (Option A - Resource-Constrained Host PCs)
# ==============================================================================
# Set LLM_PROVIDER to:
# - 'gemini_api' : Calls external Gemini API (Requires GEMINI_API_KEY). 0% CPU/VRAM.
# - 'mock'       : Stub provider returning static responses. Fast development.
# - 'ollama'     : Fully air-gapped, standard local Ollama model execution (Production VPS default).
LLM_PROVIDER=gemini_api
GEMINI_API_KEY=
